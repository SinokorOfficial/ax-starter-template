# =============================================================================
# SINOKOR AX AI 포털 — 환경변수 예시 (Phase 0)
# 실제 값/시크릿은 절대 커밋하지 마세요. 운영 시크릿은 Azure Key Vault에 보관합니다.
# 로컬: 이 파일을 apps/web/.env.local 로 복사한 뒤 값을 채우세요.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
# 포털 베이스 URL (로컬 기본값)
NEXTAUTH_URL=http://localhost:3000
# 세션 암호화 시크릿. 로컬 생성: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Dev 우회 로그인 (Entra 앱 등록 전 임시)
# true 이면 "개발용 로그인" 버튼이 노출됩니다. 운영/스테이징에서는 반드시 false.
# Entra 로그인으로 완전 전환 시 false 로 변경.
# -----------------------------------------------------------------------------
AUTH_DEV_BYPASS=true

# -----------------------------------------------------------------------------
# 실제 Entra 로그인 사용자의 임시 admin 역할 허용목록(콤마 구분, 소문자 권장).
# 여기 없는 Entra 사용자는 employee. (추후 PORTAL_PERMISSION/Entra 그룹 동기화로 대체)
# Entra 로그인 사용 시 앱 등록에 리디렉션 URI 등록 필요:
#   http://localhost:3000/api/auth/callback/azure-ad  (배포 시 해당 도메인으로)
# -----------------------------------------------------------------------------
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Entra ID (Azure AD) — 앱 등록 후 채움. 현재는 비워둠.
# NextAuth 로그인 + Microsoft Graph(사용자 조회)가 동일 앱 등록을 공유한다.
# 사용자 조회(GRAPH_DRIVER=graph)는 앱 권한 User.Read.All + 관리자 동의 필요.
# -----------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Entra 디렉터리(사용자 조회) 드라이버
#   mock  (기본) : 샘플 사용자 — Graph 자격증명 없이 화면 동작
#   graph         : 실제 Microsoft Graph /users (ENTRA_* 자격증명 사용)
# -----------------------------------------------------------------------------
GRAPH_DRIVER=mock

# -----------------------------------------------------------------------------
# APIM (업무 데이터 게이트웨이) — Phase 2. 현재 스텁이므로 미사용.
# -----------------------------------------------------------------------------
APIM_BASE_URL=

# -----------------------------------------------------------------------------
# 포털 메타 DB 드라이버 전환
#   memory : 인메모리 구현(기본, dev-bypass 흐름). Oracle 불필요.
#   oracle : 실제 Oracle PORTAL_* 스키마 사용 (node-oracledb thin 모드)
# -----------------------------------------------------------------------------
DB_DRIVER=memory

# -----------------------------------------------------------------------------
# 포털 메타 DB (온프레미스 Oracle, PORTAL_* 스키마). DB_DRIVER=oracle 일 때 사용.
# 운영 자격증명은 Key Vault + Managed Identity로 취득(lib/oracle.ts // TODO).
# dev 는 아래 .env 폴백. 시크릿은 절대 커밋 금지(.env*는 .gitignore 처리).
# -----------------------------------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=
# 예) localhost:1521/FREEPDB1  (gvenzl/oracle-free 기본 PDB)
ORACLE_CONNECT_STRING=
# 커넥션 풀 (선택)
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=4
ORACLE_POOL_TIMEOUT=60

# 운영 시크릿 보관소 (Managed Identity로 접근). 현재 // TODO 스텁.
KEY_VAULT_URI=
