# ─────────────────────────────────────────────────────────────
#  SINOKOR AX 스타터 — 로컬 환경변수
#  사용법:  cp .env.local.example .env.local
#
#  로컬 개발은 secret 이 필요 없습니다 (PKCE 로 로그인).
#  아래 값은 이미 채워져 있고, 비워야 할 건 NEXTAUTH_SECRET 하나뿐입니다.
#  → Claude 에게 "NEXTAUTH_SECRET 을 무작위로 만들어 .env.local 에 채워줘"
#    라고 하면 자동으로 생성해 넣어줍니다.
# ─────────────────────────────────────────────────────────────

# 앱 주소 (로컬은 그대로)
NEXTAUTH_URL=http://localhost:3000

# 세션 서명용 무작위 키 (Azure 와 무관한 로컬 전용 값).
#  Claude 가 생성하거나, 직접:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Entra (SinokorAxStarter) — client_id·tenant_id 는 비밀이 아니므로 그대로 둡니다.
ENTRA_TENANT_ID=67add7f6-50fb-4061-a754-f0a84ae776c0
ENTRA_CLIENT_ID=ca4d804c-e4d5-4e5c-a8ce-250ad55c1391

# ─────────────────────────────────────────────────────────────
#  ※ 로컬에선 위 3가지면 끝입니다. 아래는 건드릴 필요 없습니다.
#
#  ENTRA_CLIENT_SECRET — 로컬은 불필요(PKCE). 운영 배포(AX팀)에서만 설정하면
#    같은 코드가 자동으로 confidential 모드로 전환됩니다.
#  APIM_SP_URL / APIM_SCOPE / APIM_PORTAL_KEY — 코드 기본값(키리스)을 쓰므로 생략.
#  ADMIN_EMAILS / ADMIN_DEPARTMENTS — 관리자 판정 커스터마이즈 시에만(기본: 전산팀).
# ─────────────────────────────────────────────────────────────
