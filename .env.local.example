# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                # openssl rand -base64 32

# ── Entra ID (Azure AD) 앱 등록 — 이 앱 "자신"의 값 ──────────
ENTRA_TENANT_ID=67add7f6-50fb-4061-a754-f0a84ae776c0
ENTRA_CLIENT_ID=        # 새 앱 등록의 client id
ENTRA_CLIENT_SECRET=    # 새 앱 등록의 client secret

# ── 사내 APIM (SSO 게이트웨이) ────────────────────────────
# ⚠️ APIM_SCOPE 는 "이 앱"이 아니라 공유 APIM API 의 scope. 기본값으로 그 값이 박혀 있으니
#    보통 비워두면 됨. (이 앱의 client 는 그 API 에 pre-authorize 만 받으면 토큰 audience 가 맞음)
APIM_SCOPE=
# SSO 전용 엔드포인트 (Subscription OFF + validate-jwt 필수)
APIM_SP_URL=https://svmsapi.sinokor.co.kr/sso/v1/internal
# 구독 필수 ON 인 병행 기간에만 사용(선택). 키리스면 비워둠.
APIM_PORTAL_KEY=
