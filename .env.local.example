# ─────────────────────────────────────────────────────────────
#  SINOKOR AX — 로컬 환경변수 템플릿
#  사용법:  cp .env.local.example .env.local  후 아래 값을 채우세요.
#  .env.local 은 .gitignore 에 포함되어 깃에 올라가지 않습니다(secret 보호).
#
#  ⭐ 직접 채워야 하는 건 단 3개:  NEXTAUTH_SECRET · ENTRA_CLIENT_ID · ENTRA_CLIENT_SECRET
#     (CLIENT_ID/SECRET 은 강사/관리자에게 받으세요. 나머지는 기본값 그대로 OK)
# ─────────────────────────────────────────────────────────────

# ── NextAuth ──────────────────────────────────────────────
# 앱의 공개 URL. 로컬은 그대로, 배포 시 운영 도메인으로 변경.
# 이 URL + /api/auth/callback/azure-ad 가 Entra 앱 등록의 "리디렉션 URI"에
# 등록돼 있어야 로그인 콜백이 동작합니다(아래 사전 준비 참고).
NEXTAUTH_URL=http://localhost:3000
# ⭐ 필수 — 세션(JWT) 서명 키. 터미널에서 생성:  openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Entra ID (Azure AD) 앱 등록 ────────────────────────────
# TENANT_ID 는 시노코 테넌트 고정값(그대로 두기).
ENTRA_TENANT_ID=67add7f6-50fb-4061-a754-f0a84ae776c0
# ⭐ 필수 — 사용할 앱 등록의 client id (공유 SinokorAiPortal 재사용 또는 자기 앱)
ENTRA_CLIENT_ID=
# ⭐ 필수 — 위 앱 등록의 client secret.  ⚠️ 절대 레포에 커밋 금지!
ENTRA_CLIENT_SECRET=

# ── 사내 APIM (SSO 게이트웨이) ────────────────────────────
# ⚠️ APIM_SCOPE 는 "이 앱"이 아니라 공유 APIM API 의 scope 입니다. 코드에 기본값이
#    박혀 있으니 보통 비워두면 됩니다. (이 앱 client 는 그 API 에 pre-authorize 만
#    받으면 토큰 audience 가 맞음)
APIM_SCOPE=
# SSO 전용 엔드포인트 (Subscription OFF + validate-jwt 필수). 그대로 두기.
APIM_SP_URL=https://svmsapi.sinokor.co.kr/sso/v1/internal
# 구독키 병행 기간에만 사용(선택). 키리스(SSO)면 비워둡니다.
APIM_PORTAL_KEY=

# ── (선택) 관리자 판정 ────────────────────────────────────
# 부서가 아래 값(기본 "전산팀")이거나 이메일이 ADMIN_EMAILS 에 있으면 관리자 역할.
# ADMIN_DEPARTMENTS=전산팀
# ADMIN_EMAILS=someone@sinokor.co.kr

# ─────────────────────────────────────────────────────────────
#  ⚙️  코드 밖 사전 준비 (Entra 쪽, 1회) — README "사전 준비" 참고
#  1) 리디렉션 URI 등록:  <NEXTAUTH_URL>/api/auth/callback/azure-ad
#     (공유 SinokorAiPortal 재사용 시 localhost:3000 은 보통 이미 등록됨)
#  2) M365(메일·일정) 사용 시:  앱 등록 API 권한에 Mail.Read · Mail.Send ·
#     Calendars.Read (위임) + 관리자 동의.  없으면 로그인·My API 는 되지만
#     메일/일정에서 권한 오류가 납니다. 스코프 추가 후엔 로그아웃→재로그인 필요.
# ─────────────────────────────────────────────────────────────
